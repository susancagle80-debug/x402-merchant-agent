# x402 payment enforcement
X402_MODE=mock                  # "mock" for local dev, "facilitator" for real settlement
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAY_TO_ADDRESS=0xYourPaymentReceiverWalletAddress
X402_NETWORK=base-sepolia
X402_ASSET_ADDRESS=0xPUT_THE_REAL_USDC_CONTRACT_ADDRESS_HERE   # look this up per-network — don't trust a hardcoded guess
X402_PRICE_ATOMIC=5000          # 0.005 USDC (6 decimals)

# Data sources (wire these into auditor.py's fetch_* functions)
COUNTY_ASSESSOR_API_KEY=
PERMIT_SYSTEM_API_KEY=
DEFAULT_RPC_URL=https://sepolia.base.org
