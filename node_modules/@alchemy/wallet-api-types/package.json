{
  "name": "@alchemy/wallet-api-types",
  "private": false,
  "type": "module",
  "version": "0.2.0-alpha.3",
  "main": "./dist/esm/exports/index.js",
  "module": "./dist/esm/exports/index.js",
  "types": "./dist/types/exports/index.d.ts",
  "typings": "./dist/types/exports/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src/**/*.ts",
    "package.json",
    "!eslint.config.js",
    "!dist/**/*.tsbuildinfo",
    "!vitest.config.ts",
    "!.env",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/__tests__/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/exports/index.d.ts",
      "require": "./dist/esm/exports/index.js",
      "import": "./dist/esm/exports/index.js"
    },
    "./rpc": {
      "types": "./dist/types/exports/rpc.d.ts",
      "require": "./dist/esm/exports/rpc.js",
      "import": "./dist/esm/exports/rpc.js"
    },
    "./capabilities": {
      "types": "./dist/types/exports/capabilities.d.ts",
      "require": "./dist/esm/exports/capabilities.js",
      "import": "./dist/esm/exports/capabilities.js"
    },
    "./abi": {
      "types": "./dist/types/exports/abi.d.ts",
      "require": "./dist/esm/exports/abi.js",
      "import": "./dist/esm/exports/abi.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "bun clean && bun compile:esm && bun compile:types",
    "compile:esm": "bunx tsc --project tsconfig.build.json --outDir ./dist/esm",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --log-level warn --write --ignore-unknown .",
    "compile:types": "bunx tsc --project tsconfig.build.json --declarationDir ./dist/types --emitDeclarationOnly --declaration --declarationMap"
  },
  "devDependencies": {
    "@repo/configs": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/deep-equal": "^1.0.4",
    "eslint-plugin-import": "^2.31.0",
    "typebox": "1.0.81"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@alchemy/common": "5.0.0-beta.32",
    "deep-equal": "^2.2.3",
    "ox": "^0.6.12",
    "viem": "^2.45.0",
    "zod": "^4.4.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "gitHead": "8a7875a7bb4cd4686b700211a07cad6625eb9317"
}
